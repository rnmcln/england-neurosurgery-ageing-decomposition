.DS_Store
.venv/
.cache/
__pycache__/
*.py[cod]
.pytest_cache/

# Upstream opencodecounts files are downloaded at run time from a pinned
# commit and verified against data-raw/manifest.json; they are not
# redistributed here.
data-raw/*.rda

# Large raster and EPS renderings are regenerated by the pipeline.
outputs/**/*.tiff
outputs/**/*.eps

.env
.env.*
